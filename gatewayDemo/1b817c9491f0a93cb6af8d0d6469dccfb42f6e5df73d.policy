@id("allow_one_user")
permit(principal is gatewayDemo::User, action == gatewayDemo::Action::"GET", resource is gatewayDemo::HTTP_Request) when { ((principal has "access_token") && ((principal["access_token"]) has "acr")) && (((principal["access_token"])["acr"]).contains("agama_org.gluu.agama.pw.main")) };