@id("allow_one_user")
permit(principal == gatewayDemo::User::"admin", action == gatewayDemo::Action::"Read", resource is gatewayDemo::HTTP_Request) when { ((principal has "access_token") && ((principal["access_token"]) has "acr")) && (((principal["access_token"])["acr"]).contains("agama_org.gluu.agama.pw.main")) };